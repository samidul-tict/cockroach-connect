{
  "name": "cockroach-connect",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "contracts",
    "app",
    "subgraph"
  ],
  "scripts": {
    "contracts": "npm run --workspace=contracts",
    "app": "npm run --workspace=app",
    "subgraph": "npm run --workspace=subgraph",
    "dev": "npm run dev --workspace=app",
    "compile": "npm run compile --workspace=contracts",
    "test:contracts": "npm run test --workspace=contracts",
    "deploy:local": "npm run deploy:local --workspace=contracts"
  }
}
